# Скопируйте в .env.local и подставьте значения из Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Живой ассистент «Севиля» (Claude). Ключ Anthropic sk-ant-...
ANTHROPIC_API_KEY=
# Модель (по умолчанию claude-haiku-4-5)
ASSISTANT_MODEL=

# Серверный ключ Supabase (только сервер: серверное оформление заказа, сид). В браузер не попадает.
SUPABASE_SERVICE_ROLE_KEY=

# Пометка «демо-витрина» поверх сайта (1 — показывать даже при подключённой базе)
NEXT_PUBLIC_DEMO_MODE=
# Демо-кабинет курьера /courier (1 — открыть; по умолчанию скрыт: своей курьерской сети нет)
NEXT_PUBLIC_COURIER_DEMO=
# Сколько доверенных прокси перед приложением (Railway — 1). Влияет на определение IP для rate-limit
TRUSTED_PROXY_HOPS=1
# Общий дневной потолок запросов к ассистенту (защита бюджета ключа)
ASSISTANT_DAILY_CAP=2000

# Базовый адрес сайта для sitemap.xml, robots.txt и метаданных (после покупки домена)
NEXT_PUBLIC_SITE_URL=https://sevimli-production.up.railway.app
